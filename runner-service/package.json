{
  "name": "zth-runner-service",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --exclude test/integration",
    "test:integration": "vitest run test/integration --no-file-parallelism"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.1",
    "@fastify/rate-limit": "^11.2.2",
    "dockerode": "^5.0.1",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/dockerode": "^4.0.2",
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^4.1.12"
  },
  "overrides": {
    "light-my-request": {
      "cookie": "1.1.1"
    }
  }
}
