  {"name": "memory-sink-always-uses-the-default-format", "why": "a JsonSink stores plain lines.", "edits": [{"old": "lines_.push_back(format(level, message));", "new": "lines_.push_back(Sink::format(level, message));"}]},
  {"name": "memory-sink-keeps-the-newest-first", "why": "inserted at the front.", "edits": [{"old": "lines_.push_back(format(level, message));", "new": "lines_.insert(lines_.begin(), format(level, message));"}]},
