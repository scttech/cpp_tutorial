      {
        "file": "button.hpp",
        "old": "                    if (long_reported_) {\n                        window_open_ = false;",
        "new": "                    if (long_reported_) {"
      }
    ]
  },
  {
    "name": "double-keeps-click-flag",
    "why": "a double click also reports Click",
    "edits": [
      {
        "file": "button.hpp",
        "old": "events |= kDoubleClick;",
        "new": "events |= kDoubleClick | kClick;"
      }
    ]
  },
  {
    "name": "double-leaves-window-open",
    "why": "after a double click the window stays open (a third click is also double)",
    "edits": [
      {
        "file": "button.hpp",
        "old": "                        events |= kDoubleClick;\n                        window_open_ = false;",
        "new": "                        events |= kDoubleClick;"
      }
    ]
  },
