    "edits": [
      {
        "file": "button.hpp",
        "old": "                    held_ = 0;\n                    long_reported_ = false;",
        "new": "                    long_reported_ = false;"
      }
    ]
  },
  {
    "name": "long-reported-not-cleared",
    "why": "only the first press of all time can be a long press",
    "edits": [
      {
        "file": "button.hpp",
        "old": "                    held_ = 0;\n                    long_reported_ = false;",
        "new": "                    held_ = 0;"
      }
    ]
  },
  {
    "name": "long-press-repeats",
    "why": "LongPress is reported on every tick after the limit",
    "edits": [
      {
        "file": "button.hpp",
        "old": "if (!long_reported_ && config_.long_press_ticks > 0 && held_ == config_.long_press_ticks) {",
        "new": "if (config_.long_press_ticks > 0 && held_ >= config_.long_press_ticks) {"
      }
    ]
  },
  {
    "name": "long-press-one-late",
    "why": "LongPress arrives one tick late",
    "edits": [
      {
        "file": "button.hpp",
        "old": "held_ == config_.long_press_ticks) {",
        "new": "held_ == config_.long_press_ticks + 1) {"
      }
    ]
  },
  {
