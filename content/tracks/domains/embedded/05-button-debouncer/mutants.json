[
  {
    "name": "debounce-zero-means-two",
    "why": "a debounce of 0 is treated as 2",
    "edits": [
      {
        "file": "button.hpp",
        "old": "debounce_(config.debounce_ticks == 0 ? 1 : config.debounce_ticks)",
        "new": "debounce_(config.debounce_ticks == 0 ? 2 : config.debounce_ticks)"
      }
    ]
  },
  {
    "name": "debounce-one-too-many",
    "why": "the state flips one tick late",
    "edits": [
      {
        "file": "button.hpp",
        "old": "if (++count_ >= debounce_) {",
        "new": "if (++count_ > debounce_) {"
      }
    ]
  },
  {
    "name": "debounce-counts-total",
    "why": "bounces back to the old level do not reset the count",
    "edits": [
      {
        "file": "button.hpp",
        "old": "        } else {\n            count_ = 0;\n        }\n        return events;",
        "new": "        }\n        return events;"
      }
    ]
  },
  {
    "name": "debounce-count-not-restarted",
    "why": "the count is not cleared after a flip",
    "edits": [
      {
        "file": "button.hpp",
        "old": "                stable_ = raw;\n                count_ = 0;",
        "new": "                stable_ = raw;"
      }
    ]
  },
  {
    "name": "timers-after-debounce",
    "why": "the timers run after the debounce logic",
    "edits": [
      {
        "file": "button.hpp",
        "old": "        // A. timers of the state we were in\n        if (stable_) {",
        "new": "        if (false) {"
      }
    ]
  },
  {
    "name": "held-not-reset-on-press",
