        "new": ""
      }
    ]
  },
  {
    "name": "hex-decode-lowercase-only",
    "why": "upper-case digits are rejected",
    "edits": [
      {
        "file": "codec64.hpp",
        "old": "        if (c >= 'A' && c <= 'F') return c - 'A' + 10;\n",
        "new": ""
      }
    ]
  },
  {
    "name": "hex-decode-letters-to-z",
    "why": "letters up to z are accepted as digits",
    "edits": [
      {
        "file": "codec64.hpp",
        "old": "        if (c >= 'a' && c <= 'f') return c - 'a' + 10;",
