  {"name": "sink-is-copyable", "why": "the deleted copy operations are gone.", "edits": [{"old": "    Sink(const Sink&) = delete;  // an interface is never copied: copying through a base would slice\n    Sink& operator=(const Sink&) = delete;\n", "new": ""}]},
  {"name": "sink-write-is-not-pure", "why": "a class that implements only format is no longer abstract.", "edits": [{"old": "virtual void write(Level level, std::string_view message) = 0;", "new": "virtual void write(Level level, std::string_view message) {}"}]},
  {"name": "sink-format-is-not-pure", "why": "a class that implements only write is no longer abstract.", "edits": [{"old": "virtual std::string format(Level level, std::string_view message) const = 0;", "new": "virtual std::string format(Level level, std::string_view message) const;"}]},
  {"name": "flushable-is-not-abstract", "why": "flush has an empty body.", "edits": [{"old": "virtual void flush() = 0;", "new": "virtual void flush() {}"}]},
